# Chatwoot CE com a visão em grade das conversas.
#
# O backend deste fork é o mesmo da versão oficial; só o frontend muda. Por
# isso a imagem parte da `chatwoot/chatwoot:<versão>-ce` oficial e recompila
# os assets (public/vite e public/packs) com o mesmo `rake assets:precompile`
# do Dockerfile upstream.
#
#   docker buildx build --platform linux/arm64 -f docker/Dockerfile.grade \
#     --build-arg CHATWOOT_VERSION=v4.19.0 --build-arg GIT_SHA=$(git rev-parse HEAD) \
#     -t chatwoot-grade:v4.19.0 .
#
# CHATWOOT_VERSION precisa ser a tag sobre a qual este branch foi rebaseado.

ARG CHATWOOT_VERSION=v4.19.0

FROM chatwoot/chatwoot:${CHATWOOT_VERSION}-ce AS assets

ARG PNPM_VERSION=10.2.0
ARG NODE_OPTIONS="--max-old-space-size=4096 --openssl-legacy-provider"
ENV NODE_OPTIONS=${NODE_OPTIONS}

# A imagem final do upstream traz o node, mas não o npm/pnpm.
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && npm install -g pnpm@${PNPM_VERSION}

WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm i --frozen-lockfile

COPY . /app
# public/packs vem da imagem base (o .dockerignore exclui o do host) e o
# precompile regera o sdk.js dentro dela.
RUN rm -rf public/vite enterprise \
  && SECRET_KEY_BASE=precompile_placeholder RAILS_LOG_TO_STDOUT=enabled \
     bundle exec rake assets:precompile

FROM chatwoot/chatwoot:${CHATWOOT_VERSION}-ce

ARG GIT_SHA=""

# Troca os assets inteiros, para não sobrar o bundle antigo com outros hashes.
RUN rm -rf /app/public/vite /app/public/packs /app/app/javascript
COPY --from=assets /app/public/vite /app/public/vite
COPY --from=assets /app/public/packs /app/public/packs
COPY --from=assets /app/app/javascript /app/app/javascript
RUN if [ -n "$GIT_SHA" ]; then echo "$GIT_SHA" > /app/.git_sha; fi
